diff --git a/doomgeneric/doomgeneric_koreader.c b/doomgeneric/doomgeneric_koreader.c
new file mode 100644
index 0000000..99498aa
--- /dev/null
+++ b/doomgeneric/doomgeneric_koreader.c
@@ -0,0 +1,178 @@
+// doomgeneric backend for KOReader: built as libdoom.so and driven from Lua via ffi.
+// Doom never gets to exit the host process: every exit() in the engine is compiled
+// as doom_exit(), which longjmps back to whichever exported entry point is running.
+
+#include <math.h>
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "doomgeneric.h"
+
+#define EXPORT __attribute__((visibility("default")))
+
+static jmp_buf doom_jmp;
+static int doom_jmp_armed = 0;
+static int doom_state = 0;      // 0 = not started, 1 = running, 2 = quit/errored
+static int doom_exit_code = 0;
+
+// Virtual clock: stands still while the game is paused (plugin closed, device asleep).
+static uint64_t paused_total_ms = 0;
+static uint64_t paused_at_ms = 0;
+static int paused = 0;
+
+#define KEYQUEUE_SIZE 64
+static unsigned short key_queue[KEYQUEUE_SIZE];
+static unsigned int key_write = 0, key_read = 0;
+
+static uint8_t gamma_lut[256];
+
+char *doom_configdir = "./";
+extern int key_nextweapon, key_prevweapon;
+
+void doom_exit(int code) __attribute__((noreturn));
+void doom_exit(int code)
+{
+    doom_exit_code = code;
+    doom_state = 2;
+    if (doom_jmp_armed)
+        longjmp(doom_jmp, 1);
+    // Unreachable in practice: the engine only runs inside doom_init/doom_tick.
+    for (;;) pause();
+}
+
+static uint64_t real_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+void DG_Init(void) {}
+void DG_DrawFrame(void) {}
+void DG_SetWindowTitle(const char *title) { (void)title; }
+
+void DG_SleepMs(uint32_t ms)
+{
+    usleep(ms * 1000);
+}
+
+uint32_t DG_GetTicksMs(void)
+{
+    uint64_t now = paused ? paused_at_ms : real_ms();
+    return (uint32_t)(now - paused_total_ms);
+}
+
+int DG_GetKey(int *pressed, unsigned char *key)
+{
+    if (key_read == key_write)
+        return 0;
+    unsigned short data = key_queue[key_read % KEYQUEUE_SIZE];
+    key_read++;
+    *pressed = data >> 8;
+    *key = data & 0xff;
+    return 1;
+}
+
+EXPORT void doom_key(int pressed, int key)
+{
+    if (key_write - key_read >= KEYQUEUE_SIZE)
+        return;
+    key_queue[key_write % KEYQUEUE_SIZE] = (unsigned short)(((pressed ? 1 : 0) << 8) | (key & 0xff));
+    key_write++;
+}
+
+EXPORT void doom_set_paused(int p)
+{
+    if (p && !paused) {
+        paused_at_ms = real_ms();
+        paused = 1;
+    } else if (!p && paused) {
+        paused_total_ms += real_ms() - paused_at_ms;
+        paused = 0;
+    }
+}
+
+// Returns 1 when the game is running, 0 if it quit or hit a fatal error.
+EXPORT int doom_init(const char *iwad, const char *configdir)
+{
+    static char iwad_buf[512], config_buf[512];
+    static char *argv[] = { "doom", "-iwad", iwad_buf, NULL };
+
+    if (doom_state != 0)
+        return doom_state == 1;
+
+    snprintf(iwad_buf, sizeof(iwad_buf), "%s", iwad);
+    snprintf(config_buf, sizeof(config_buf), "%s", configdir);
+    doom_configdir = config_buf;
+
+    // E-ink shows Doom far too dark; lift the midtones.
+    for (int i = 0; i < 256; i++)
+        gamma_lut[i] = (uint8_t)(255.0 * pow(i / 255.0, 0.55) + 0.5);
+
+    doom_state = 1;
+    doom_jmp_armed = 1;
+    if (setjmp(doom_jmp) == 0)
+        doomgeneric_Create(3, argv);
+    doom_jmp_armed = 0;
+    // Vanilla leaves weapon cycling unbound; the touch pad needs it.
+    key_nextweapon = ']';
+    key_prevweapon = '[';
+    return doom_state == 1;
+}
+
+EXPORT int doom_tick(void)
+{
+    if (doom_state != 1)
+        return 0;
+    doom_jmp_armed = 1;
+    if (setjmp(doom_jmp) == 0)
+        doomgeneric_Tick();
+    doom_jmp_armed = 0;
+    return doom_state == 1;
+}
+
+EXPORT int doom_exit_status(void) { return doom_exit_code; }
+
+static const uint8_t bayer8[8][8] = {
+    {  0, 32,  8, 40,  2, 34, 10, 42 },
+    { 48, 16, 56, 24, 50, 18, 58, 26 },
+    { 12, 44,  4, 36, 14, 46,  6, 38 },
+    { 60, 28, 52, 20, 62, 30, 54, 22 },
+    {  3, 35, 11, 43,  1, 33,  9, 41 },
+    { 51, 19, 59, 27, 49, 17, 57, 25 },
+    { 15, 47,  7, 39, 13, 45,  5, 37 },
+    { 63, 31, 55, 23, 61, 29, 53, 21 },
+};
+
+// Scales the 320x200 frame into an 8bpp grey buffer. dither=1 gives pure black/white
+// (ordered dither) so the fast A2 waveform can show it without smearing. invert=1
+// pre-inverts so KOReader's night mode inversion shows Doom the right way round.
+EXPORT void doom_render(uint8_t *dst, int dw, int dh, int stride, int dither, int invert)
+{
+    static int xmap[4096];
+    if (!DG_ScreenBuffer || dw > 4096)
+        return;
+    for (int x = 0; x < dw; x++)
+        xmap[x] = x * DOOMGENERIC_RESX / dw;
+    uint8_t flip = invert ? 0xff : 0;
+    for (int y = 0; y < dh; y++) {
+        const uint32_t *src = DG_ScreenBuffer + (y * DOOMGENERIC_RESY / dh) * DOOMGENERIC_RESX;
+        uint8_t *out = dst + y * stride;
+        const uint8_t *brow = bayer8[y & 7];
+        for (int x = 0; x < dw; x++) {
+            uint32_t p = src[xmap[x]];
+            uint32_t r = (p >> 16) & 0xff, g = (p >> 8) & 0xff, b = p & 0xff;
+            uint8_t v = gamma_lut[(r * 77 + g * 150 + b * 29) >> 8];
+            if (dither)
+                v = (v >> 2) > brow[x & 7] ? 255 : 0;
+            out[x] = v ^ flip;
+        }
+    }
+}
+
+EXPORT int doom_width(void) { return DOOMGENERIC_RESX; }
+EXPORT int doom_height(void) { return DOOMGENERIC_RESY; }
